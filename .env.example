# Slack bot (xoxb-...) with files:write and chat scopes; channel ID (e.g. C01234567) where reports are posted.
# Leave either unset to run without Slack file upload.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL_ID=C01234567

# Frontend URL for CORS during local development.
CLIENT_ORIGIN=http://localhost:5173

# Backend port.
PORT=3001

# If set, only these client IPs may call the API (after Railway proxy: first X-Forwarded-For hop).
# Comma-separated; whitespace around entries is ignored.
# Example: ALLOWED_IP=97.252.135.203,162.233.240.200
# Leave unset for open access (e.g. local dev). GET /api/health is exempt.
# ALLOWED_IP=
